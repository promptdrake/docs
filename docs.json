{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aisbir Cloud Nusantara",
  "colors": {
    "primary": "#15a393",
    "light": "#06c4c9",
    "dark": "#148078"
  },
