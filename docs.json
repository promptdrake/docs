      "telegram": "https://t.me/aisbirnusantara",
      "youtube": "https://www.youtube.com/@aisbirnusantara",
      "threads": "https://www.threads.com/@aisbirnusantara",
      "discord": "https://discord.gg/FkEfeDFh7c"
    }
  },
  "description": "Aisbir Cloud Docs",
