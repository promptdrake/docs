              "pterodactyl/upload-folder",
              "pterodactyl/manage-database",
              "pterodactyl/create-tunnel"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "ai-tools/cursor",
              "essentials/reusable-snippets"
            ],
            "hidden": true
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ],
            "hidden": true
          }
        ]
      },
      {
        "tab": "Patch Note",
        "groups": [
          {
            "group": "2026",
            "pages": [
              {
                "group": "tele",
                "pages": [
